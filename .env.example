# Sem esta variável, usa instance/safrasmart.db (SQLite local).
# O comando python iniciar.py prepara as tabelas automaticamente.
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/safrasmart
# Para provedores que exigem TLS, acrescente ?sslmode=require à URL.
HOST=127.0.0.1
PORT=5000
# O comando único inicia servidor e worker juntos.
START_WORKER=true
# Google Earth Engine / NDVI (não usa uma chave de API simples).
ENABLE_NDVI=true
# Cole TODO o conteúdo do arquivo JSON ENTRE estas aspas simples.
# Pode ocupar várias linhas: comece em { e termine em }, mantendo os escapes \n.
# Exemplo de estrutura: veja docs/EARTH_ENGINE.md.
GEE_SERVICE_ACCOUNT_JSON=''
# Opcional: vazio usa automaticamente o project_id presente no JSON.
GEE_PROJECT=
MIN_NDVI_COVERAGE=0.5
