# Sem esta variável, usa instance/safrasmart.db (SQLite local).
# Configure a URL real e execute python -m safrasmart.db upgrade.
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/safrasmart
# Para provedores que exigem TLS, acrescente ?sslmode=require à URL.
HOST=127.0.0.1
PORT=5000
# NDVI é opcional; usa as credenciais já existentes do seu projeto Earth Engine.
ENABLE_NDVI=true
# GEE_KEY_PATH=/caminho/seguro/conta-servico.json
# GEE_PROJECT=seu-projeto-google-cloud
MIN_NDVI_COVERAGE=0.5
