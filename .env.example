# Oracle Database (19c+ / XE 21c / Free). Preencha os 3 campos juntos.
# A senha pode conter @, / ou %; mantenha aspas simples para preservar o texto.
# ORACLE_USER=safrasmart
# ORACLE_PASSWORD='sua_senha'
# ORACLE_DSN=localhost:1521/FREEPDB1
# FIAP ou outro servidor: use o host, a porta e o serviço fornecidos.
#
# Alternativa: URL SQLAlchemy completa, com caracteres especiais codificados.
# DATABASE_URL=oracle+oracledb://usuario:senha@localhost:1521?service_name=FREEPDB1
# DATABASE_URL tem precedência sobre ORACLE_USER/PASSWORD/DSN.
# Sem conexão configurada, usa instance/safrasmart.db (SQLite local).
# Execute python -m safrasmart.db upgrade antes de iniciar API e worker.
#
# Oracle Cloud com wallet (Thin mode, diretório extraído fora do repositório):
# ORACLE_DSN=nome_do_alias_high
# ORACLE_CONFIG_DIR=/caminho/seguro/wallet
# ORACLE_WALLET_LOCATION=/caminho/seguro/wallet
# ORACLE_WALLET_PASSWORD='senha_do_wallet'
HOST=127.0.0.1
PORT=5000
# NDVI é opcional; usa as credenciais já existentes do seu projeto Earth Engine.
ENABLE_NDVI=true
# GEE_KEY_PATH=/caminho/seguro/conta-servico.json
# GEE_PROJECT=seu-projeto-google-cloud
MIN_NDVI_COVERAGE=0.5
